using System.Collections;
using System.Collections.Generic;
using UnityEditor;
using UnityEngine;

public class CursorManager : Singleton<CursorManager>
{
    private Color cursorColor;
    private Texture2D cursorTexture;
    private Vector2 hotSpot = Vector2.zero;

    public async void Init()
    {
        /*
        cursorTexture = await AssetsBundleManager.LoadTexture2D("default_icon_cursor");
        if (cursorTexture != null)
            Cursor.SetCursor(cursorTexture, Vector2.one, CursorMode.Auto);
        */
        Cursor.SetCursor(PlayerSettings.defaultCursor, Vector2.one, CursorMode.ForceSoftware);

        WindowMode();
    }

    public void ResetCursor()
    {
        Cursor.SetCursor(cursorTexture, Vector2.one, CursorMode.Auto);
    }

    public void SetVisible(bool visible)
    {
        Cursor.visible = visible;
    }

    public void SetLockMode(CursorLockMode cursorLockMode)
    {
        Cursor.lockState = cursorLockMode;
    }

    public void FPSMode()
    {
        Cursor.visible = false;
        Cursor.lockState = CursorLockMode.Locked;
    }

    public void WindowMode()
    {
        Cursor.visible = true;
        Cursor.lockState = CursorLockMode.None;
    }
}
