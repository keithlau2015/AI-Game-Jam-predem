using UnityEngine;

public static class FIOSystem
{
    private readonly static string key = "57_dQ0<fd~1dCMNfjc8_dp09m>kiytT0";
    private readonly static byte[] keyArray = UTF8Encoding.UTF8.GetBytes(key);
    private readonly static string iv = "a_03Mkd<[~sDtC02";
    private readonly static byte[] ivArray = UTF8Encoding.UTF8.GetBytes(iv);

    private static readonly string[] SizeSuffixes = { "bytes", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB" };

    public static event Action onFinishSaveObj;

    public enum FileType : int
    {
        none = -1,
        Resources = 0,
        Player = 1,
    }

    public static string[] filePath { get; private set; } = new string[3];
    public static string[] fileExtension { get; private set; } = new string[3];
    public static bool isInit { get; private set; } = false;

    private static RijndaelManaged rijndaelManaged;

    public static void Init()
    {
        filePath[0] = $"{Application.dataPath}/Resources/";
        filePath[1] = $"{Application.persistentDataPath}/Player/";

        fileExtension[0] = ".res";
        fileExtension[1] = ".player";

        rijndaelManaged = new RijndaelManaged();
        rijndaelManaged.Key = keyArray;
        rijndaelManaged.IV = ivArray;

        #region Type Converter
        #region Tuple 2
        TypeDescriptor.AddAttributes(typeof((System.Int32, System.Int32)), new TypeConverterAttribute(typeof(TupleConverter.TwoParam<System.Int32, System.Int32>)));
        TypeDescriptor.AddAttributes(typeof((System.Int64, System.Int64)), new TypeConverterAttribute(typeof(TupleConverter.TwoParam<System.Int64, System.Int64>)));
        #endregion

        #region Tuple 3
        TypeDescriptor.AddAttributes(typeof((System.Int32, System.Int32, System.Int32)), new TypeConverterAttribute(typeof(TupleConverter.ThreeParam<System.Int32, System.Int32, System.Int32>)));
        TypeDescriptor.AddAttributes(typeof((System.Int64, System.Int64, System.Int64)), new TypeConverterAttribute(typeof(TupleConverter.ThreeParam<System.Int64, System.Int64, System.Int64>)));
        #endregion
        #endregion

        isInit = true;
    }

    public static async void CreateFile(string fileName, FileType fileType, string content = null)
    {
        if (!isInit)
            Init();

        string[] contents = new string[1];
        contents[0] = content;
        await WriteFile(fileType, fileName, contents);
    }

    public static bool CheckFileIsExits(string fileName, FileType fileType)
    {
        return File.Exists($"{filePath[(int)fileType]}{fileName}{fileExtension[(int)fileType]}");
    }

    public static string[] GetAllFileInDirectory(string path, string[] excludeExtension = null)
    {
        if (!Directory.Exists(path))
            return null;
        DirectoryInfo directoryInfo = new DirectoryInfo(path);
        FileInfo[] files = directoryInfo.GetFiles();
        List<string> allFilesName = new List<string>();
        foreach (FileInfo fileInfo in files)
        {
            bool isExclude = false;
            if (excludeExtension != null)
            {
                foreach (string ext in excludeExtension)
                {
                    if (fileInfo.Extension.Equals(ext))
                    {
                        isExclude = true;
                        break;
                    }

                }
            }
            if (isExclude)
                continue;
            allFilesName.Add(fileInfo.Name);
        }
        return allFilesName.ToArray();
    }

    public static async void Store<T>(T[] objs, FileType fileType, string fileName)
    {
        if (!isInit)
            Init();

        await WriteFile<T>(fileType, fileName, objs);
    }

    public static async void Store<T>(T obj, FileType fileType, string fileName)
    {
        if (!isInit)
            Init();

        if (obj == null)
            return;

        T[] objArray = { obj };
        await WriteFile<T>(fileType, fileName, objArray);
    }

    private static async UniTask<bool> WriteFile<T>(FileType fileType, string fileName, T[] objs)
    {
        if (!isInit)
            Init();

        if (string.IsNullOrEmpty(fileName))
            fileName = $"{typeof(T).Name}";

        string path = filePath[(int)fileType];
        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }
        using (FileStream fileStream = new FileStream($"{path}{fileName}{fileExtension[(int)fileType]}", FileMode.Create))
        {            
            try
            {
                var settings = new JsonSerializerSettings();
                // This tells your serializer that multiple references are okay.
                settings.ReferenceLoopHandling = ReferenceLoopHandling.Ignore;
                string json = JsonConvert.SerializeObject(objs, settings);
                Debug.Log($"Save: {json}");
                byte[] datas = await EncrpytStringToBytes(json, rijndaelManaged.Key, rijndaelManaged.IV);
                await fileStream.WriteAsync(datas, 0, datas.Length);
            }
            catch (SerializationException exception)
            {
                Debug.Log("Save failed. Error: " + exception.Message);
                return false;
            }
            finally
            {
                fileStream.Close();
                onFinishSaveObj?.Invoke();
            }
            return true;
        }
    }

    private static List<string> ConvertObjToString<T>(T[] objs)
    {
        List<string> result = new List<string>();
        foreach (T obj in objs)
        {
            result.Add(obj.ToString());
        }
        return result;
    }

    private static void ConvertMultiObjsToBin<T>(Stream stream, T[] objs)
    {
        foreach (T obj in objs)
        {
            ConvertObjToBin(stream, obj);
        }
    }

    private static void ConvertObjToBin<T>(Stream stream, T obj)
    {
        BinaryFormatter formatter = new BinaryFormatter();
        try
        {
            formatter.Serialize(stream, obj);
        }
        catch (SerializationException exception)
        {
            Debug.Log("Save failed. Error: " + exception.Message);
        }
    }

    public static async UniTask<List<T>> LoadFile<T>(string key = "", FileType fileType = FileType.Player)
    {
        if (!isInit)
            Init();

        string path = $"{filePath[(int)fileType]}{typeof(T).Name}{fileExtension[(int)fileType]}";

        if (!string.IsNullOrEmpty(key))
            path = $"{filePath[(int)fileType]}{key}{fileExtension[(int)fileType]}";

        if (!File.Exists(path))
        {
            Debug.LogWarning($"FIOSystem Load: the path is not exists {path}");
            return new List<T>();
        }

        List<T> returnValue = new List<T>();
        try
        {
            byte[] rawMeta = File.ReadAllBytes(path);
            if (rawMeta == null || rawMeta.Length <= 0)
                return new List<T>();
            string meta = await DecryptStringFromBytes(rawMeta, rijndaelManaged.Key, rijndaelManaged.IV);
            Debug.Log($"meta: {meta}");
            returnValue = JsonConvert.DeserializeObject<List<T>>(meta);
        }
        catch (SerializationException exception)
        {
            if (exception != null)
                Debug.Log("Save System Exception Catach!!\n" +
                    "Exception Source: " + exception.Source + "\n" +
                    "Exception Message: " + exception.Message);

            return returnValue;
        }
        finally
        {

        }

        return returnValue;
    }

    public static async UniTask<bool> StoreCSV<T>(string fileName, T[] objs)
    {
        if (!isInit)
            Init();

        string rawData = "";
        PropertyInfo[] propertyInfos = typeof(T).GetProperties();
        foreach (PropertyInfo propertyInfo in propertyInfos)
        {
            if (rawData.Length != 0)
                rawData += ",";
            rawData += propertyInfo.Name;
        }
        rawData += "\n";
        foreach (T obj in objs)
        {
            bool isFirst = true;
            foreach (PropertyInfo propertyInfo in propertyInfos)
            {
                if (isFirst)
                    isFirst = false;
                else
                    rawData += ",";

                rawData += propertyInfo.GetValue(obj).ToString();
            }
            rawData += "\n";
        }

        string path = filePath[(int)FileType.Resources] + "/LocalConfig/";
        string fileExt = fileExtension[(int)FileType.Resources];
        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }
        using (FileStream fileStream = new FileStream(path + fileName + fileExt, FileMode.Create))
        {
            try
            {
                byte[] datas = await EncrpytStringToBytes(rawData, rijndaelManaged.Key, rijndaelManaged.IV);
                await fileStream.WriteAsync(datas, 0, datas.Length);
            }
            catch (SerializationException exception)
            {
                Debug.Log("Save failed. Error: " + exception.Message);
                return false;
            }
            finally
            {
                fileStream.Close();
                onFinishSaveObj?.Invoke();
            }
            return true;
        }
    }

    public static async UniTask<bool> StoreCSV(string fileName, string csvData)
    {
        if (!isInit)
            Init();

        string path = filePath[(int)FileType.Resources] + "/LocalConfig/";
        string fileExt = fileExtension[(int)FileType.Resources];

        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }
        using (FileStream fileStream = new FileStream(path + fileName + fileExt, FileMode.Create))
        {
            try
            {
                byte[] datas = await EncrpytStringToBytes(csvData, rijndaelManaged.Key, rijndaelManaged.IV);
                await fileStream.WriteAsync(datas, 0, datas.Length);
            }
            catch (SerializationException exception)
            {
                Debug.Log("Save failed. Error: " + exception.Message);
                return false;
            }
            finally
            {
                fileStream.Close();
                onFinishSaveObj?.Invoke();
            }
            return true;
        }
    }

    public static async UniTask<List<T>> LoadEncryptedCSV<T>() where T : new()
    {
        if (!isInit)
            Init();

        List<T> result = new List<T>();
        string path = $"{filePath[(int)FileType.Resources]}/LocalConfig/{typeof(T).Name}{fileExtension[(int)FileType.Resources]}";
        
        Regex extensionRX = new Regex(@"\.res");
        if (path == string.Empty || !extensionRX.IsMatch(path))
        {
            Debug.LogError($"LoadEncryptedCSV: Invalid Args");
            return result;
        }
        
        string meta = "";
        if (!File.Exists(path))
        {
            Debug.LogWarning($"LoadEncryptedCSV: the path is not exists {path}");
            return new List<T>();
        }

        try
        {
            byte[] rawMeta = File.ReadAllBytes(path);
            if (rawMeta == null || rawMeta.Length <= 0)
                return new List<T>();
            meta = await DecryptStringFromBytes(rawMeta, rijndaelManaged.Key, rijndaelManaged.IV);
            //Debug.Log($"meta: {meta}");
        }
        catch (SerializationException exception)
        {
            if (exception != null)
                Debug.Log("Save System Exception Catach!!\n" +
                    "Exception Source: " + exception.Source + "\n" +
                    "Exception Message: " + exception.Message);

            return null;
        }

        List<string> fieldNameList = new List<string>();
        string[] split = meta.Split('\n');
        foreach (string line in split)
        {
            if (line == null || line.Length == 0 || line == "")
                continue;

            //Get raw data
            var values = line.Split(',');

            //if the first line
            if (fieldNameList.Count == 0)
                fieldNameList.AddRange(values);
            else
            {
                T newObj = new T();
                for (int i = 0; i < fieldNameList.Count; i++)
                {
                    PropertyInfo propertyInfo = newObj.GetType().GetProperty(fieldNameList[i]);
                    if (propertyInfo == null)
                    {
                        Debug.LogError($"LoadEncryptedCSV: field not found[{fieldNameList[i]}]");
                        return result;
                    }
                    propertyInfo.SetValue(newObj, Convert.ChangeType(values[i], propertyInfo.PropertyType));
                }
                result.Add(newObj);
            }
        }

        return result;
    }

    public static string LoadCSV(string path)
    {
        string result = "";
        
        Regex extensionRX = new Regex(@"\.csv$");
        if (path == string.Empty || !extensionRX.IsMatch(path))
        {
            Debug.LogError($"LoadCSV: Invalid Args");
            return result;
        }

        using (StreamReader streamReader = new StreamReader(path))
        {
            while (!streamReader.EndOfStream)
            {
                result += streamReader.ReadLine();
                result += "\n";
            }
        }

        return result;
    }

