using UnityEngine;
using UnityEngine.UI;

public class PausePanel : MonoBehaviour, IPreviousablePanel
{
    [SerializeField]
    private Button exitBtn, settingBtn;
    [SerializeField]
    private GUITweener_Alpha alphaTween;
    private void Awake()
    {
        if (exitBtn != null)
            exitBtn.onClick.AddListener(() => PauseManager.singleton.Pause(false));
    }

    public void Hide()
    {
        alphaTween.SetTween(1, 0);
        alphaTween.SetOnCompleteCB(() => this.gameObject.SetActive(false));
        alphaTween.Play();
    }

    public void Show()
    {
        alphaTween.SetTween(0, 1);
        alphaTween.SetOnCompleteCB(() => this.gameObject.SetActive(true));
        alphaTween.Play();
    }
}
