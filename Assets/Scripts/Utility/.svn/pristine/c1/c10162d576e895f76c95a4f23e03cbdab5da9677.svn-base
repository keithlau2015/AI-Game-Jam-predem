using Cysharp.Threading.Tasks;
using System;
using System.Collections.Generic;
using UnityEngine;

public class SoundManager : Singleton<SoundManager>
{
    public enum Type : int
    {
        SFX = 0,
        BGM = 1,
    }

    public class SoundSetting
    {
        public float master;
        public float soundEffect;
        public float bgm;
        public bool muteSFX;
        public bool muteBGM;

        public SoundSetting()
        {
            this.master = 1f;
            this.soundEffect = 1f;
            this.bgm = 1f;
            this.muteSFX = false;
            this.muteBGM = false;
        }
    }

    public bool isInit { get; private set; }

    public event Action<float> onMasterVolumeChange;
    public event Action<float> onSFXVolumeChange;
    public event Action<float> onBGMVolumeChange;
    public event Action<bool> onMuteMaster;
    public event Action<bool> onMuteSFX;
    public event Action<bool> onMuteBGM;

    private Dictionary<string, AudioClip> sourcesMap = new Dictionary<string, AudioClip>();
    private Dictionary<int, AudioSource> audioSourceByTag = new Dictionary<int, AudioSource>();

    private SoundSetting soundSettingConfig;

    public async UniTask<int> Init(IProgress<int> progress, List<AudioClip> sources, SoundSetting soundSetting = null)
    {
        int progressCount = 0;
        if (soundSetting == null)
            soundSetting = new SoundSetting();

        sourcesMap.Clear();

        foreach (int type in Enum.GetValues(typeof(Type)))
        {
            CreateAudioSource(type);
            progressCount++;
            progress.Report(progressCount);
        }

        foreach (AudioClip curClip in sources)
        {
            this.sourcesMap.Add(curClip.name, curClip);
            progressCount++;
            progress.Report(progressCount);
        }

        if (soundSettingConfig.muteSFX)
            MuteSFX();
        if (soundSettingConfig.muteBGM)
            MuteBGM();

        await new WaitUntil(() => { return progressCount == sources.Count + Enum.GetValues(typeof(Type)).Length; });
        this.isInit = true;
        return progressCount;
    }

    #region Set
    public void SetMasterVolume(float newVolume)
    {
        if (!isInit)
            return;

        if (newVolume > 1)
            newVolume = 1;

        onMasterVolumeChange?.Invoke(newVolume);
        soundSettingConfig.master = newVolume;
    }

    public void SetSoundEffectVolume(float newVolume)
    {
        if (!isInit)
            return;

        if (newVolume > 1)
            newVolume = 1;

        onSFXVolumeChange?.Invoke(newVolume);
        soundSettingConfig.soundEffect = newVolume;
    }

    public void SetBGMVolume(float newVolume)
    {
        if (!isInit)
            return;

        if (newVolume > 1)
            newVolume = 1;

        onBGMVolumeChange?.Invoke(newVolume);
        soundSettingConfig.bgm = newVolume;
    }

    public void MuteAll()
    {
        if (!isInit)
            return;

        foreach (AudioSource audioSource in audioSourceByTag.Values)
        {
            audioSource.mute = true;
        }
        this.onMuteMaster?.Invoke(true);
        soundSettingConfig.muteBGM = true;
        soundSettingConfig.muteSFX = true;
    }

    public void UnMuteAll()
    {
        if (!isInit)
            return;

        foreach (AudioSource audioSource in audioSourceByTag.Values)
        {
            audioSource.mute = false;
        }
        this.onMuteMaster?.Invoke(false);
        soundSettingConfig.muteBGM = false;
        soundSettingConfig.muteSFX = false;
    }

    public void MuteBGM()
    {
        if (!isInit)
            return;

        AudioSource audioSource = null;
        if (!audioSourceByTag.TryGetValue((int)Type.BGM, out audioSource))
            return;

        audioSource.mute = true;
        this.onMuteBGM?.Invoke(true);
        soundSettingConfig.muteBGM = true;
    }
    public void UnMuteBGM()
    {
        if (!isInit)
            return;

        AudioSource audioSource = null;
        if (!audioSourceByTag.TryGetValue((int)Type.BGM, out audioSource))
            return;

        audioSource.mute = false;
        this.onMuteBGM?.Invoke(false);
        soundSettingConfig.muteBGM = false;
    }

    public void MuteSFX()
    {
        if (!isInit)
            return;

        AudioSource audioSource = null;
        if (!audioSourceByTag.TryGetValue((int)Type.SFX, out audioSource))
            return;

        audioSource.mute = true;
        onMuteSFX?.Invoke(true);
        soundSettingConfig.muteSFX = true;
    }

    public void UnMuteSFX()
    {
        if (!isInit)
            return;

        AudioSource audioSource = null;
        if (!audioSourceByTag.TryGetValue((int)Type.SFX, out audioSource))
            return;

        audioSource.mute = false;
        onMuteSFX?.Invoke(false);
        soundSettingConfig.muteSFX = false;
    }
    #endregion

    #region Get
    private float GetVolumeByTag(int tag)
    {
        float result = soundSettingConfig.master;
        switch (tag)
        {
            case (int)Type.BGM:
                result = GetBGM();
                break;
            case (int)Type.SFX:
                result = GetSoundEffect();
                break;
        }
        return result;
    }
    public float GetMasterVolume()
    {
        return soundSettingConfig.master;
    }

    public float GetSoundEffect()
    {
        return soundSettingConfig.soundEffect * soundSettingConfig.master;
    }

    public float GetBGM()
    {
        return soundSettingConfig.bgm * soundSettingConfig.master;
    }
    #endregion

    #region Play
    public void Play(int tag, string id)
    {
        if (!isInit)
            return;

        AudioSource audioSource = null;
        if (!audioSourceByTag.TryGetValue(tag, out audioSource))
            return;
        AudioClip audioClip = null;
        if (!sourcesMap.TryGetValue(id, out audioClip))
            return;
        audioSource.volume = GetVolumeByTag(tag);
        audioSource.clip = audioClip;
        audioSource.Play();
    }
    #endregion

    private AudioSource CreateAudioSource(int type)
    {
        GameObject audioSourceGO = new GameObject($"AudioSource_{type}");
        AudioSource audioSource = audioSourceGO.AddComponent<AudioSource>();
        audioSourceByTag.Add(type, audioSource);
        return audioSource;
    }

    protected override void OnDestroy()
    {
        base.OnDestroy();
        onBGMVolumeChange = null;
        onMasterVolumeChange = null;
        onMuteBGM = null;
        onMuteMaster = null;
        onMuteSFX = null;
        onSFXVolumeChange = null;

        //Save Config
        FIOSystem.Store<SoundSetting>(new SoundSetting[] { soundSettingConfig }, FIOSystem.FileType.Preference);
    }
}