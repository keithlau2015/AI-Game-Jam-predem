using Cysharp.Threading.Tasks;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.AddressableAssets;
using UnityEngine.ResourceManagement.AsyncOperations;

public class UIManager : Singleton<UIManager>
{
    #region reference
    [SerializeField]
    private Transform refTopLayer;
    [SerializeField]
    private Transform refViewLayer;
    [SerializeField]
    private Transform refBaseLayer;
    [SerializeField]
    private PausePanel refPausePanel;
    #endregion

    public static Transform topLayer { get; private set; }
    public static Transform viewLayer { get; private set; }
    public static Transform baseLayer { get; private set; }

    private static Stack<IPreviousablePanel> previousablePanels = new Stack<IPreviousablePanel>();

    protected override void Awake()
    {
        base.Awake();
        PauseManager.singleton.OnPause += ShowPausePanel;
    }

    public static async UniTask<GameObject> LoadUI(string key, Transform parent = null)
    {
        //By Default Set Panel to View Layer
        if (parent == null)
            parent = viewLayer;
        AsyncOperationHandle<GameObject> loadOp = Addressables.LoadAssetAsync<GameObject>(key);
        await loadOp;
        if(loadOp.Status == AsyncOperationStatus.Succeeded)
        {
            AsyncOperationHandle asyncInstantiateOP = Addressables.InstantiateAsync(key, parent);
            if (asyncInstantiateOP.IsDone)
            {
                GameObject result = asyncInstantiateOP.Result as GameObject;
                IPreviousablePanel previousablePanel = null;
                if (result.TryGetComponent(out previousablePanel))
                    previousablePanels.Push(previousablePanel);

                Addressables.Release(loadOp);
                return result;
            }
        }
        return null;
    }

    public static IPreviousablePanel PreviousPage()
    {
        if (previousablePanels == null)
            return null;

        if (previousablePanels.Count == 0 || previousablePanels.Peek() == null)
            return null;

        previousablePanels.Pop().Hide();
        IPreviousablePanel currentPanel = previousablePanels.Peek();
        currentPanel.Show();
        return currentPanel;
    }

    private void ShowPausePanel(bool show)
    {
        if (refPausePanel == null)
            return;
        if (show)
        {
            previousablePanels.Push(refPausePanel);
            refPausePanel.Show();
        }
        else
        {
            previousablePanels.Pop();
            refPausePanel.Hide();
        }
    }

    protected override void OnDestroy()
    {
        PauseManager.singleton.OnPause -= ShowPausePanel;
        base.OnDestroy();
    }
}
