using System.Collections;
using System.Collections.Generic;

namespace BehaviourTree
{
    public enum NodeState
    {
        Running,
        Success,
        Fail
    }

    public class Node
    {
        protected NodeState state;

        public Node parent;
        protected List<Node> child = new List<Node>();

        private Dictionary<string, object> dataContext = new Dictionary<string, object>();

        public Node()
        {
            parent = null;
        }

        public Node(List<Node> child)
        {
            foreach (Node node in child)
            {
                Attach(node);
            }
        }

        private void Attach(Node node)
        {
            node.parent = this;
            child.Add(node);
        }

        /// <summary>
        /// Execute in each frame
        /// </summary>
        /// <returns>Current State</returns>
        public virtual NodeState Evaluate() => NodeState.Fail;

        public bool AddData(string key, object value)
        {
            return dataContext.TryAdd(key, value);
        }

        public object GetData(string key)
        {
            object result = null;
            if(dataContext.TryGetValue(key, out result))
                return result;

            Node node = parent;
            while(node != null)
            {
                result = node.GetData(key);
                if(result != null)
                    return result;
                node = node.parent;
            }

            return result;
        }

        public bool ClearData(string key)
        {
            if(dataContext.ContainsKey(key))
            {
                dataContext.Remove(key);
                return true;
            }

            Node node = parent;
            while (node != null)
            {
                bool cleared = node.ClearData(key);
                if (cleared)
                    return true;
                node = node.parent;
            }

            return false;
        }
    }
}