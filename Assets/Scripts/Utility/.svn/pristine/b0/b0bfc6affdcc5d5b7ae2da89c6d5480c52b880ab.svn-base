using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.AddressableAssets;
using UnityEngine.ResourceManagement.AsyncOperations;

public class AssetsBundleManager : Singleton<AssetsBundleManager>
{
    public static IEnumerator LoadSprite(string key, Action<Sprite> cb = null)
    {
        AsyncOperationHandle<Sprite> loadOp = Addressables.LoadAssetAsync<Sprite>(key);
        yield return loadOp;
        if (loadOp.Status == AsyncOperationStatus.Succeeded)
        {
            Sprite sprite = loadOp.Result;
            cb?.Invoke(sprite);
        }
        Addressables.Release(loadOp);
    }
}
